{
  "name": "vina-legal-server",
  "version": "0.1.0",
  "description": "Vietnam Legal Consultant System using GraphRAG and PathRAG",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "pnpm run dev:server",
    "dev:server": "tsx watch src/api/server.ts",
    "start": "node dist/api/server.js",
    "build-graph": "tsx src/scripts/build-graph.ts",
    "build-index-by-congraphdb": "tsx src/scripts/build-index-by-congraphdb.ts",
    "build-index-by-congraphdb-lite": "tsx src/scripts/build-index-by-congraphdb-lite.ts",
    "build-index-by-lancedb": "tsx src/scripts/build-index-by-lancedb.ts",
    "benchmark-vectors": "tsx src/scripts/benchmark-vector-stores.ts",
    "embedding-service": "cd ../embedding-service && python main.py",
    "use-api-embedder": "node scripts/set-embed-backend.cjs api",
    "use-transformers-embedder": "node scripts/set-embed-backend.cjs transformers",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:integration:graph": "vitest tests/integration/test-graph-build.test.ts",
    "test:integration:pathrag": "vitest tests/integration/test-pathrag.test.ts",
    "test:integration:msgraphrag": "vitest tests/integration/test-msgraphrag.test.ts",
    "test:integration:hybrid": "vitest tests/integration/test-hybrid.test.ts",
    "test:integration": "vitest tests/integration/",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "keywords": [
    "legal",
    "vietnam",
    "graphrag",
    "pathrag",
    "langchain",
    "vectordb"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@congraph-rag/core": "file:../../../CongraphRAG/congraph-rag/packages/core",
    "@congraph-rag/engines": "file:../../../CongraphRAG/congraph-rag/packages/engines",
    "@fastify/static": "^9.1.1",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@lancedb/lancedb": "^0.5.2",
    "@langchain/anthropic": "^0.3.0",
    "@langchain/core": "^0.3.0",
    "@xenova/transformers": "^2.17.2",
    "congraphdb": "file:../../../ConGraph/congraphdb",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.5",
    "onnxruntime-node": "^1.24.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/coverage-v8": "^2.1.8",
    "concurrently": "^9.2.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.5.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.0",
    "vitest": "^2.1.8"
  }
}
