# ============================================================================
# VinaLegal Environment Configuration
# ============================================================================
# Copy this file to .env and update the values as needed

# Server Configuration
PORT=3000
HOST=127.0.0.1

# Vector Store Type
# Options: congraph (ConGraphDB - recommended) or lancedb
VECTOR_STORE_TYPE=congraph

# Embedding Backend
# Options: transformers (WebAssembly), api (Python ONNX), or llamacpp (GGUF)
EMBEDDING_BACKEND=transformers
EMBEDDING_API_URL=http://localhost:3018

# LLM Configuration (for Anthropic Claude, OpenAI, Local Llama, or Google Gemini)
# Options: llama, openai, anthropic, gemini
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
# Default LLM endpoint, loaded at startup and shown in the admin LLM Monitor.
# It can be overridden at runtime from the LLM Monitor (not persisted here).
LLM_API_URL=http://localhost:5814
LLM_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=your_api_key_here
OPENAI_API_KEY=your_api_key_here

# Logging Level
# Options: debug, info, warn, error
LOG_LEVEL=info
