# ============================================================================
# VinaLegal Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the values. This file holds names and
# empty placeholders only. Real keys go in the gitignored .env, never here.

# Server Configuration
PORT=3000
HOST=127.0.0.1

# Vector Store Type
# Options: congraph (ConGraphDB - recommended) or lancedb
VECTOR_STORE_TYPE=congraph

# Legacy embedding settings (used by the /api/consult path only)
EMBEDDING_API_URL=http://localhost:3018
# Legacy: read only by the old-index comparison (ER1). Deleted in phase 02.
# EMBEDDING_BACKEND=transformers

# ----------------------------------------------------------------------------
# Gemini chat (agent path). Gemini is the only provider the agent accepts.
# ----------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MAX_RETRIES=2
GEMINI_MAX_CONCURRENCY=4
LLM_MODEL=gemini-3.5-flash-lite

# ----------------------------------------------------------------------------
# Embeddings (gemini-embedding-2, 768-d). Rollback to transformers is two
# settings, see README "Rollback to the legacy index".
# ----------------------------------------------------------------------------
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
GEMINI_EMBEDDING_API_KEY=
EMBED_BATCH_SIZE=50
EMBED_MAX_CONCURRENCY=2
EMBED_MAX_TOKENS_BUDGET=2000000

# ----------------------------------------------------------------------------
# Paths
# ----------------------------------------------------------------------------
CONGRAPH_VECTOR_DB_PATH=storage/congraph_vectors_gemini-embedding-2_768.cgraph
DATA_SOURCE_PATH=data/Docs/Vietnam Civil Law.json

# ----------------------------------------------------------------------------
# Agent loop, working memory and session store
# ----------------------------------------------------------------------------
AGENT_MAX_STEPS=4
SHORT_TERM_MAX_TURNS=8
SHORT_TERM_MAX_TOKENS=512
HISTORY_MAX_TOKENS=1500
MAX_OBSERVATION_TOKENS=6000
MAX_SESSIONS=1000
SESSION_TTL_S=3600
AGENT_SESSIONS_DIR=storage/agent-sessions

# ----------------------------------------------------------------------------
# Langfuse Cloud. Off by default. metadata_only sends no question or answer text.
# ----------------------------------------------------------------------------
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE=metadata_only
LANGFUSE_PROJECT_ID=
LANGFUSE_SAMPLE_RATE=1
LANGFUSE_ENVIRONMENT=development

# ----------------------------------------------------------------------------
# Legacy keys (the /api/consult path only; the agent does not read these)
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_API_URL is intentionally not listed. When it is unset, the legacy
# Gemini adapter uses Google's endpoint.

# Logging Level
# Options: debug, info, warn, error
LOG_LEVEL=info
