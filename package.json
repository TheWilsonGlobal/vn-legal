{
  "name": "vina-legal",
  "version": "1.0.0",
  "description": "Intelligent legal consultation system for Vietnam Civil Law using GraphRAG and PathRAG methodologies.",
  "keywords": [
    "graphrag",
    "rag",
    "knowledge-graph",
    "legal-tech",
    "vietnam-law",
    "langchain",
    "lancedb",
    "fastify",
    "typescript",
    "cytoscape",
    "sigmajs",
    "react",
    "llama",
    "llm",
    "vector-search"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT,ADMIN\" -c \"blue,green,magenta\" \"pnpm run dev:server\" \"pnpm run dev:client\" \"pnpm run dev:admin\"",
    "dev:server": "tsx watch apps/server/src/api/server.ts",
    "dev:client": "vite",
    "dev:admin": "vite --config vite.admin.config.ts",
    "build": "pnpm run build:server && pnpm run build:client && pnpm run build:admin",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "build:admin": "vite build --config vite.admin.config.ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "eval": "tsx apps/server/tests/eval/retrieval.eval.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build-graph": "tsx apps/server/src/scripts/build-graph.ts",
    "build-index-by-congraphdb": "tsx apps/server/src/scripts/build-index-by-congraphdb.ts",
    "build-index-by-congraphdb-lite": "tsx apps/server/src/scripts/build-index-by-congraphdb-lite.ts",
    "build-index-by-lancedb": "tsx apps/server/src/scripts/build-index-by-lancedb.ts",
    "benchmark-vectors": "tsx apps/server/src/scripts/benchmark-vector-stores.ts",
    "rebuild-index:gemini": "tsx apps/server/src/scripts/rebuild-index-gemini.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^9.1.1",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@google/genai": "^2.32.0",
    "@iam/client": "link:../../../ARCs/xOps/iam/packages/iam-client",
    "@lancedb/lancedb": "^0.5.2",
    "@langchain/core": "^1.3.4",
    "@langchain/langgraph": "^1.7.0",
    "@langchain/openai": "^1.8.0",
    "@langfuse/client": "^6.1.1",
    "@langfuse/langchain": "^6.1.1",
    "@langfuse/otel": "^6.1.1",
    "@langfuse/tracing": "^6.1.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.0.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/otlp-exporter-base": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "@supabase/supabase-js": "^2.49.1",
    "@xenova/transformers": "^2.17.2",
    "congraph-rag": "0.2.1",
    "congraphdb": "^0.2.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.5",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-layout-noverlap": "^0.4.2",
    "graphology-metrics": "^2.4.0",
    "onnxruntime-node": "^1.24.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sigma": "^3.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^2.1.8",
    "concurrently": "^9.2.1",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.14.0",
    "jose": "^6.2.15",
    "jsdom": "^29.0.2",
    "prettier": "^3.4.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^8.0.4",
    "vitest": "^2.1.8"
  }
}
